{
  "name": "json-pretty-print",
  "version": "4.0.2",
  "description": "JSON Pretty Print Online",
  "author": "Jason Lee <jason@zerodevx.com>",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "lint": "npm run check && prettier --check . && eslint",
    "format": "prettier --write .",
    "test:e2e": "playwright install && playwright test",
    "test": "npm run test:e2e",
    "deploy": "npx oneclickpush -d build -r https://github.com/zerodevx/jpp.git -f",
    "deploy:redirects": "npx oneclickpush -d redirects -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@zerodevx/svelte-json-view": "^2.0.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jaison": "^2.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-games": "^0.1.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "zipurl": "^2.1.1"
  },
  "allowScripts": {
    "fsevents": true
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "license": "ISC",
  "repository": "github:zerodevx/json-pretty-print",
  "homepage": "https://zerodevx.github.io/jpp/",
  "keywords": [
    "json",
    "pretty-print",
    "online"
  ]
}
